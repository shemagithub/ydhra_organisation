# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ccf_admin

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@creationcare.org
ADMIN_PASSWORD=ChangeMeCCF2026
ADMIN_NAME=CCF Admin

# Optional: also write public JSON for static hosting
SYNC_PUBLIC_JSON=true
PUBLIC_CONTENT_PATH=../public/content/site-content.json
PUBLIC_SITE_URL=https://creationcarefoundation.org

# Live XentriPay (production). Do not use the test host.
XENTRIPAY_BASE_URL=https://xentripay.com
XENTRIPAY_API_KEY=
XENTRIPAY_WEBHOOK_SECRET=
XENTRIPAY_BUSINESS_ACCOUNT_ID=

# Secure SMTP from the hosting mailbox. Password stays in .env only.
SMTP_HOST=server126.web-hosting.com
SMTP_PORT=465
SMTP_USER=info@creationcarefoundation.org
SMTP_PASS=
SMTP_FROM_NAME=Creation Care Foundation
